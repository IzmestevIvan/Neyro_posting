# Обязательное
BOT_TOKEN=123456:AA...
ADMIN_IDS=000000000
GEMINI_API_KEY=

# База. Локально — свой PostgreSQL; в Docker строку собирает docker-compose.yml
DATABASE_URL=postgresql://neyro:neyro@localhost:5432/neyro
POSTGRES_USER=neyro
POSTGRES_PASSWORD=
POSTGRES_DB=neyro

# Модели. Линейка Gemini меняется чаще кода, поэтому вынесены сюда
GEMINI_MODEL_MAIN=gemini-3.6-flash
GEMINI_MODEL_VERIFY=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Адрес панели. Telegram открывает мини-приложение только по HTTPS
SITE_ADDRESS=example.com
PUBLIC_URL=https://example.com
HOST=0.0.0.0
PORT=8080

LOGO_DIR=data/logos
DEFAULT_DAILY_LIMIT=500
POLL_INTERVAL=90

# Только для локальной отладки в браузере. На сервере этой строки быть не должно:
# она пропускает любого, кто подставит чужой id.
# DEV_AUTH=1
