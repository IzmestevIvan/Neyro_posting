# Billing and standalone /account configuration. No credentials are included.
# Merge confirmed values into the existing protected .env or runtime environment.
# This example file and .billing.env are NOT automatically loaded by the app.
# The current requested check uses the existing LIVE shop; charges would be real.
# Keep both switches off until shop, receipts and website login are configured.
BILLING_ENABLED=0
YOOKASSA_ENV=live
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# HTTPS origin only: no /account suffix, query or fragment.
PUBLIC_URL=https://example.com

# BotFather -> bot -> Login Widget -> Client ID.
# Register the website origin in Allowed URLs; open the UI at /account.
# This code uses Telegram.Login.auth with server-side ID-token verification.
# A Telegram OIDC Client Secret is not consumed by this integration.
TELEGRAM_LOGIN_CLIENT_ID=

# npd_manual: self-employed merchant creates and shares receipts in My Tax.
# yookassa_54fz: merchant uses a connected 54-FZ fiscal service.
YOOKASSA_RECEIPT_MODE=npd_manual
# The fields below are only consumed by yookassa_54fz, not by npd_manual.
# Confirm with the merchant/accountant and receipt provider. Do not guess.
# VAT code supported by YooKassa: 1..12; leave empty until confirmed.
YOOKASSA_VAT_CODE=
# Supported: service or intellectual_activity; choose the actual subject.
YOOKASSA_PAYMENT_SUBJECT=
# Supported: full_payment only; confirm the actual fiscal flow.
# full_prepayment is disabled: closing receipt automation is not implemented.
YOOKASSA_PAYMENT_MODE=
# For npd_manual, confirms the manual My Tax receipt workflow is in place.
YOOKASSA_FISCAL_READY=0

# Business mode is suspended and saved data is retained.
BUSINESS_MODE_ENABLED=0
